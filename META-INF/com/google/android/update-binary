#!/sbin/sh
########################################
# update-binary - kompatibel Magisk & KernelSU-Next
# Magisk  : pakai util_functions.sh (install_module)
# KernelSU/APatch/lain: langsung jalankan customize.sh
########################################
umask 022
ui_print() { echo "$1"; }
OUTFD=$2
ZIPFILE=$3

if [ -f /data/adb/magisk/util_functions.sh ]; then
  . /data/adb/magisk/util_functions.sh
  install_module
  exit 0
fi

# --- fallback non-Magisk (KernelSU-Next / APatch) ---
[ -n "$MODPATH" ] || MODPATH="$(dirname "$0")"
if [ -f "$MODPATH/customize.sh" ]; then
  MODPATH="$MODPATH" sh "$MODPATH/customize.sh"
fi
exit 0
